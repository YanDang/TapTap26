# ==========================================
# Unity Standard .gitignore for GitHub
# ==========================================

# Unity 临时与缓存目录（绝对不要上传）
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# 编译日志与崩溃转储
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# 移动端构建输出与签名密钥（保护私钥安全并减小仓库体积）
*.apk
*.aab
*.app
*.ipa
*.keystore
*.jks
*.p12
*.pem
*.mobileprovision

# Unity 自动化包与测试场景
*.unitypackage
*.unitypackage.meta
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*

# 资源与脚本生成缓存
ExportedObj/
.consulo/
.gradle/
/ServerData/
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting 自动生成配置
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Visual Studio / VSCode / Rider IDE 项目与缓存文件
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity3D 生成的 meta 附属文件
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 美术与 DCC 工具临时备份文件
*.blend1
*.blend1.meta
*.blend2
*.blend2.meta
*.aseprite~
*.psd~
*.tmp
*.bak
*.swp
*~
~$*

# 操作系统特定临时文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
[Tt]humbs.db
[Ee]hthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
